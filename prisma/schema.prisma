datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// SYSTEM ENUMS
// ==========================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum LoginStatus {
  SUCCESS
  FAILED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ApiKeyProvider {
  GEMINI
  CLAUDE
  GROQ
  OPENAI
  DEEPSEEK
  OPENROUTER
}

enum RequirementStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REQUESTED_CHANGES
  COMMENTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UploadSource {
  FILE_UPLOAD
  MANUAL_INPUT
  JIRA_SYNC
  CONFLUENCE
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum RiskLevel {
  HIGH
  MEDIUM
  LOW
}

enum RequirementType {
  FUNCTIONAL
  NON_FUNCTIONAL
  BUSINESS_RULE
  VALIDATION
  SECURITY
}

enum Explicitness {
  EXPLICIT
  IMPLICIT
}

enum AtomicRequirementStatus {
  ACTIVE
  DEPRECATED
  UPDATED
}

enum Severity {
  CRITICAL
  MAJOR
  MINOR
  TRIVIAL
}

enum AutomationStatus {
  MANUAL
  AUTOMATED
  CANNOT_BE_AUTOMATED
}

enum SuiteType {
  SMOKE
  REGRESSION
  SANITY
  API
  PERFORMANCE
  SECURITY
  CUSTOM
}

enum RunStatus {
  PENDING
  RUNNING
  COMPLETED
}

enum ExecutionStatus {
  PASSED
  FAILED
  BLOCKED
  SKIPPED
  PENDING
}

enum ProviderStatus {
  ACTIVE
  DEGRADED
  OFFLINE
}

enum GenerationStatus {
  SUCCESS
  FAILED
  RUNNING
}

enum DefectStatus {
  NEW
  ASSIGNED
  OPEN
  FIXED
  VERIFIED
  CLOSED
  REJECTED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIAL
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ==========================================
// IDENTITY, USER & SYSTEM ACCESS
// ==========================================

model User {
  id                     String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                  String                    @unique
  passwordHash           String?                   @map("password_hash")
  name                   String?
  phoneNumber            String                    @map("phone_number")
  isVerified             Boolean                   @default(false) @map("is_verified")
  verificationCode       String?                   @map("verification_code")
  verificationCodeExpiry DateTime?                 @map("verification_code_expiry")
  role                   String                    // "Analyst" or "User" - legacy field kept for backward compatibility
  status                 UserStatus                @default(PENDING_VERIFICATION)
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")
  deletedAt              DateTime?                 @map("deleted_at")
  
  // Relations
  roles                  UserRole[]
  permissionOverrides    UserPermissionOverride[]
  sessions               Session[]
  refreshTokens          RefreshToken[]
  loginHistories         LoginHistory[]
  passwordResets         PasswordResetToken[]
  ownedWorkspaces        Workspace[]               @relation("WorkspaceOwner")
  workspaceMemberships   WorkspaceMember[]
  sentInvitations        WorkspaceInvitation[]     @relation("SentInvitations")
  apiKeys                ApiKey[]
  projects               Project[]
  uploadedVersions       RequirementVersion[]
  activities             ProjectActivity[]
  analyses               Analysis[]
  scenarioVersions       TestScenarioVersion[]
  testCaseReviews        TestCaseVersion[]         @relation("TestCaseReviewer")
  testCaseVersions       TestCaseVersion[]         @relation("TestCaseAuthor")
  testCaseHistories      TestCaseHistory[]
  testExecutions         TestExecution[]
  executionHistories     ExecutionHistory[]
  promptVersions         PromptVersion[]
  promptHistories        PromptHistory[]
  generations            AiGeneration[]
  defectsAssigned        Defect[]                  @relation("DefectAssignee")
  defectsReported        Defect[]                  @relation("DefectReporter")
  defectStatusHistories  DefectStatusHistory[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  auditLogs              AuditLog[]
  exports                ExportHistory[]
  imports                ImportHistory[]
  mappingsCreated        ExcelImportMapping[]
  approvalsGiven         ApprovalHistory[]
  comments               Comment[]
  attachmentsUploaded    Attachment[]
  userUsage              UserUsage?
  reviewsWritten         ReviewHistory[]
  aiUsageLogs            AiUsageLog[]

  @@map("users")
}

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String           @unique // e.g. "SUPER_ADMIN", "ADMIN", "USER"
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")
  
  // Relations
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String                   @unique // e.g. "users:create", "workspaces:delete"
  description String?
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")
  
  // Relations
  roles       RolePermission[]
  userOverrides UserPermissionOverride[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  
  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  
  // Relations
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermissionOverride {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  value        Boolean    // true = Allow override, false = Deny override
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  
  // Relations
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permission_overrides")
}

// ==========================================
// SESSION & AUTH AUDITING MODULE
// ==========================================

model Session {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  token         String         @unique
  ipAddress     String?        @map("ip_address")
  userAgent     String?        @map("user_agent")
  expiresAt     DateTime       @map("expires_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  
  // Relations
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@map("sessions")
}

model RefreshToken {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  sessionId      String?  @map("session_id") @db.Uuid
  token          String   @unique
  expiresAt      DateTime @map("expires_at")
  isRevoked      Boolean  @default(false) @map("is_revoked")
  replacedByToken String?  @map("replaced_by_token")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  
  // Relations
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session        Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@map("refresh_tokens")
}

model LoginHistory {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String?     @map("user_id") @db.Uuid
  emailAttempted String      @map("email_attempted")
  status         LoginStatus
  ipAddress      String?     @map("ip_address")
  userAgent      String?     @map("user_agent")
  failureReason  String?     @map("failure_reason")
  createdAt      DateTime    @default(now()) @map("created_at")
  
  // Relations
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("login_histories")
}

model EmailVerificationToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String
  token      String    @unique
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  verifiedAt DateTime? @map("verified_at")

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  usedAt    DateTime? @map("used_at")
  
  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ==========================================
// WORKSPACE & ENTERPRISE CONFIGURATION
// ==========================================

model Workspace {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  slug                 String                @unique
  ownerId              String                @map("owner_id") @db.Uuid
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  deletedAt            DateTime?             @map("deleted_at")
  
  // Relations
  owner                User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members              WorkspaceMember[]
  invitations          WorkspaceInvitation[]
  roles                WorkspaceRole[]
  apiKeys              ApiKey[]
  projects             Project[]
  subscription         WorkspaceSubscription?
  usageMeter           UsageMeter?
  orgSettings          OrganizationSettings?
  storageMetrics       StorageMetrics?
  workspaceUsage       WorkspaceUsage?
  auditLogs            AuditLog[]
  aiUsageLogs          AiUsageLog[]

  @@map("workspaces")
}

model WorkspaceRole {
  id          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String                    @map("workspace_id") @db.Uuid
  name        String                    // e.g. "Admin", "Analyst", "Viewer"
  description String?
  isSystem    Boolean                   @default(false) @map("is_system")
  createdAt   DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime                  @updatedAt @map("updated_at")
  
  // Relations
  workspace   Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  permissions WorkspaceRolePermission[]
  invitations WorkspaceInvitation[]

  @@unique([workspaceId, name])
  @@map("workspace_roles")
}

model WorkspacePermission {
  id          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String                    @unique // e.g. "project:create", "member:invite"
  description String?
  createdAt   DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime                  @updatedAt @map("updated_at")
  
  // Relations
  roles       WorkspaceRolePermission[]
  overrides   WorkspaceMemberPermissionOverride[]

  @@map("workspace_permissions")
}

model WorkspaceRolePermission {
  roleId       String              @map("role_id") @db.Uuid
  permissionId String              @map("permission_id") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at")
  
  // Relations
  role         WorkspaceRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   WorkspacePermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("workspace_role_permissions")
}

model WorkspaceMember {
  id          String                              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String                              @map("workspace_id") @db.Uuid
  userId      String                              @map("user_id") @db.Uuid
  roleId      String                              @map("role_id") @db.Uuid
  joinedAt    DateTime                            @default(now()) @map("joined_at")
  deletedAt   DateTime?                           @map("deleted_at")
  
  // Relations
  workspace   Workspace                           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User                                @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole                       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  overrides   WorkspaceMemberPermissionOverride[]

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model WorkspaceMemberPermissionOverride {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId     String              @map("member_id") @db.Uuid
  permissionId String              @map("permission_id") @db.Uuid
  value        Boolean             // true = Allow override, false = Deny override
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  
  // Relations
  member       WorkspaceMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  permission   WorkspacePermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([memberId, permissionId])
  @@map("workspace_member_permission_overrides")
}

model WorkspaceInvitation {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  email       String
  roleId      String           @map("role_id") @db.Uuid
  invitedById String           @map("invited_by_id") @db.Uuid
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  
  // Relations
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        WorkspaceRole    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy   User             @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)

  @@map("workspace_invitations")
}

// ==========================================
// INTEGRATIONS (API KEYS) MODULE
// ==========================================

model ApiKey {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  workspaceId  String?        @map("workspace_id") @db.Uuid
  provider     ApiKeyProvider
  encryptedKey String         @map("encrypted_key")
  keyHint      String         @map("key_hint")
  name         String?
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  deletedAt    DateTime?      @map("deleted_at")
  
  // Relations
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  usages       AiUsageLog[]

  @@map("api_keys")
}

// ==========================================
// PROJECT & REQUIREMENT MANAGEMENT
// ==========================================

model Project {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String?               @map("workspace_id") @db.Uuid
  userId          String                @map("user_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at")
  requirementText String                @map("requirement_text")
  analysis        Json?
  scenarios       Json?
  testCases       Json?                 @map("test_cases")
  rtm             Json?
  suites          Json?
  versions        Json?

  // Relations (Legacy & Workspace)
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace       Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Relations (New Project/Requirements Module)
  settings        ProjectSettings?
  statistics      ProjectStatistics[]
  activities      ProjectActivity[]
  tags            ProjectTag[]
  folders         RequirementFolder[]
  documents       RequirementDocument[]
  labels          RequirementLabel[]

  // Relations (Test Management Module)
  testScenarios   TestScenario[]
  scenarioCategories ScenarioCategory[]
  scenarioTags    ScenarioTag[]
  testCasesList   TestCase[]
  testSuites      TestSuite[]
  testRuns        TestRun[]

  // Relations (AI & Defects Modules)
  promptTemplates PromptTemplate[]
  generations     AiGeneration[]
  fallbackOrders  AiFallbackOrder[]
  defects         Defect[]

  // Relations (Enterprise Management)
  exports         ExportHistory[]
  imports         ImportHistory[]
  excelMappings   ExcelImportMapping[]
  dashStats       DashboardStatistics[]
  dailyAnalytics  DailyAnalytics[]
  monthlyAnalytics MonthlyAnalytics[]
  projectMetrics  ProjectMetrics?

  @@map("projects")
}

model ProjectSettings {
  projectId          String   @id @map("project_id") @db.Uuid
  defaultModel       String?  @map("default_model") // e.g. "gemini-1.5-pro"
  enableAutoAnalysis Boolean  @default(false) @map("enable_auto_analysis")
  retentionDays      Int      @default(30) @map("retention_days")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_settings")
}

model ProjectStatistics {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  totalRequirements Int      @default(0) @map("total_requirements")
  totalVersions     Int      @default(0) @map("total_versions")
  totalAnalyses     Int      @default(0) @map("total_analyses")
  aiTokensConsumed  Int      @default(0) @map("ai_tokens_consumed")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_statistics")
}

model ProjectActivity {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  action     String   // e.g. "REQUIREMENT_CREATE", "ANALYSIS_RUN"
  entityType String   @map("entity_type") // e.g. "RequirementDocument", "RequirementVersion"
  entityId   String?  @map("entity_id") @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("project_activities")
}

model ProjectTag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  name      String
  color     String?  // e.g. "#FF5733"
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@map("project_tags")
}

model RequirementFolder {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String              @map("project_id") @db.Uuid
  parentId    String?             @map("parent_id") @db.Uuid
  name        String
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  // Relations
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent      RequirementFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subfolders  RequirementFolder[] @relation("FolderHierarchy")
  documents   RequirementDocument[]

  @@unique([projectId, parentId, name])
  @@map("requirement_folders")
}

model RequirementDocument {
  id          String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String                     @map("project_id") @db.Uuid
  folderId    String?                    @map("folder_id") @db.Uuid
  title       String
  description String?
  status      RequirementStatus          @default(DRAFT)
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @updatedAt @map("updated_at")
  deletedAt   DateTime?                  @map("deleted_at")

  // Relations
  project     Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder      RequirementFolder?         @relation(fields: [folderId], references: [id], onDelete: SetNull)
  versions    RequirementVersion[]
  labels      RequirementDocumentLabel[]

  @@map("requirement_documents")
}

model RequirementVersion {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId     String               @map("document_id") @db.Uuid
  versionNumber  Int                  @map("version_number")
  rawRequirement String               @map("raw_requirement")
  platform       String               // e.g. "iOS", "Android", "Web"
  domain         String               // e.g. "Payments", "Authentication"
  uploadSource   UploadSource         @map("upload_source")
  language       String               @default("en")
  uploadedById   String               @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at")

  // Relations
  document       RequirementDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy     User                 @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  metadata       RequirementMetadata[]
  analyses       Analysis[]
  comments       Comment[]
  attachments    Attachment[]
  approvals      ApprovalHistory[]
  reviews        ReviewHistory[]

  @@unique([documentId, versionNumber])
  @@map("requirement_versions")
}

model RequirementLabel {
  id        String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String                     @map("project_id") @db.Uuid
  name      String
  color     String?                    // Hex code
  createdAt DateTime                   @default(now()) @map("created_at")

  // Relations
  project   Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documents RequirementDocumentLabel[]

  @@unique([projectId, name])
  @@map("requirement_labels")
}

model RequirementDocumentLabel {
  documentId String              @map("document_id") @db.Uuid
  labelId    String              @map("label_id") @db.Uuid

  // Relations
  document   RequirementDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  label      RequirementLabel    @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([documentId, labelId])
  @@map("requirement_document_labels")
}

model RequirementMetadata {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId String             @map("version_id") @db.Uuid
  key       String
  value     String
  
  // Relations
  version    RequirementVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, key])
  @@map("requirement_metadata")
}

// ==========================================
// REQUIREMENT INTELLIGENCE
// ==========================================

model Analysis {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId       String                 @map("version_id") @db.Uuid
  analyzedById    String                 @map("analyzed_by_id") @db.Uuid
  summary         String                 @db.Text
  modelUsed       String                 @map("model_used")
  tokensConsumed  Int?                   @map("tokens_consumed")
  durationMs      Int?                   @map("duration_ms")
  createdAt       DateTime               @default(now()) @map("created_at")

  // Relations
  version         RequirementVersion     @relation(fields: [versionId], references: [id], onDelete: Cascade)
  analyzedBy      User                   @relation(fields: [analyzedById], references: [id], onDelete: Restrict)
  domains         DomainClassification[]
  confidence      ConfidenceScore[]
  actors          Actor[]
