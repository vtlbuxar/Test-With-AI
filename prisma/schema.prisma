  assigneeId         String?               @map("assignee_id") @db.Uuid
  reporterId         String                @map("reporter_id") @db.Uuid
  linkedRequirementId String?              @map("linked_requirement_id") @db.Uuid
  linkedTestCaseId   String?               @map("linked_test_case_id") @db.Uuid
  linkedExecutionId  String?               @map("linked_execution_id") @db.Uuid
